using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using Fortune_telling.Database;
using Fortune_telling.Models;
using Fortune_telling.Services;

namespace Fortune_telling
{
    public partial class frmFortune : Form
    {
        private DatabaseManager dbManager;
        private YijingService yijingService;
        private List<YaoType> currentYaos;
        private GuaXiang primaryGua;
        private GuaXiang changedGua;

        public frmFortune()
        {
            InitializeComponent();
            dbManager = new DatabaseManager();
            yijingService = new YijingService();
            currentYaos = new List<YaoType>();
            LoadFortuneRecords();
        }

        private void LoadFortuneRecords()
        {
            if (frmStart.currentUserId <= 0)
            {
                MessageBox.Show("無法載入占卜記錄：用戶信息不完整");
                return;
            }

            List<FortuneRecord> records = dbManager.GetUserFortuneRecords(frmStart.currentUserId);

            // 如果有列表控件，可以在這裡綁定數據
            // 例如：listBox1.DataSource = records;
        }

        /// <summary>
        /// 生成單個爻（點擊按鈕時調用）
        /// </summary>
        public void GenerateYao()
        {
            if (currentYaos.Count >= 6)
            {
                MessageBox.Show("已經抽取了6個爻，請查看結果或重新開始占卜");
                return;
            }

            // 生成爻
            YaoType yaoType = yijingService.GenerateYao();
            currentYaos.Add(yaoType);

            // 更新 UI 顯示當前爻
            DisplayCurrentYao(yaoType);

            // 檢查是否完成6個爻
            if (currentYaos.Count == 6)
            {
                CompletesDivination();
            }
        }

        /// <summary>
        /// 顯示當前生成的爻
        /// </summary>
        private void DisplayCurrentYao(YaoType yaoType)
        {
            string yaoDisplay;
            switch (yaoType)
            {
                case YaoType.LaoYang:
                    yaoDisplay = "●●● (老陽)";
                    break;
                case YaoType.ShaoYang:
                    yaoDisplay = "○○● (少陽)";
                    break;
                case YaoType.ShaoYin:
                    yaoDisplay = "●○○ (少陰)";
                    break;
                case YaoType.LaoYin:
                    yaoDisplay = "○○○ (老陰)";
                    break;
                default:
                    yaoDisplay = "未知";
                    break;
            }

            // 假設有一個標籤或文本框來顯示當前爻的信息
            // 例如：lblCurrentYao.Text = $"第{currentYaos.Count}爻：{yaoDisplay}";

            // 也可以在消息框中顯示
            MessageBox.Show($"第{currentYaos.Count}爻：{yaoDisplay}");
        }

        /// <summary>
        /// 完成占卜（生成6個爻後）
        /// </summary>
        private void CompletesDivination()
        {
            try
            {
                // 生成第一卦和變卦
                (primaryGua, changedGua) = yijingService.GenerateFullDivination(currentYaos);

                // 計算老陽老陰數量
                int oldYangYinCount = currentYaos.Count(y => y == YaoType.LaoYang || y == YaoType.LaoYin);

                // 決定顯示哪個卦
                GuaXiang displayGua = oldYangYinCount <= 3 ? primaryGua : changedGua;

                // 顯示結果
                ShowDivinationResult(displayGua, oldYangYinCount);

                // 保存結果到數據庫
                SaveDivinationResult(displayGua, oldYangYinCount);

                // 重置以便下次占卜
                ResetDivination();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"占卜出錯：{ex.Message}");
            }
        }

        /// <summary>
        /// 顯示占卜結果
        /// </summary>
        private void ShowDivinationResult(GuaXiang gua, int oldYangYinCount)
        {
            string result = $"【{gua.GuaName} 卦】\n" +
                           $"卦序：第{gua.GuaNumber}卦\n" +
                           $"含義：{gua.Meaning}\n\n" +
                           $"爻象：\n";

            foreach (var yao in gua.Yaos)
            {
                result += yao.ToString() + "\n";
            }

            result += $"\n老陽老陰總數：{oldYangYinCount}\n";

            if (oldYangYinCount <= 3)
                result += "顯示本卦";
            else
                result += "顯示變卦（老陽老陰數 >= 4）";

            MessageBox.Show(result, "占卜結果");
        }

        /// <summary>
        /// 保存占卜結果到數據庫
        /// </summary>
        private void SaveDivinationResult(GuaXiang gua, int oldYangYinCount)
        {
            if (frmStart.currentUserId <= 0)
            {
                MessageBox.Show("請先登入才能保存占卜結果");
                return;
            }

            // 組裝詳細的結果字符串
            string detailedResult = $"卦名：{gua.GuaName}\n" +
                                  $"卦序：{gua.GuaNumber}\n" +
                                  $"含義：{gua.Meaning}\n" +
                                  $"老陽老陰數：{oldYangYinCount}\n" +
                                  $"爻象：";

            foreach (var yao in gua.Yaos)
            {
                detailedResult += $"\n{yao}";
            }

            if (dbManager.SaveFortuneRecord(frmStart.currentUserId, detailedResult))
            {
                MessageBox.Show("占卜結果已保存");
                LoadFortuneRecords();
            }
        }

        /// <summary>
        /// 重置占卜狀態
        /// </summary>
        private void ResetDivination()
        {
            currentYaos.Clear();
            primaryGua = null;
            changedGua = null;
        }

        public void SaveFortuneResult(string result)
        {
            if (frmStart.currentUserId <= 0)
            {
                MessageBox.Show("請先登入才能保存占卜結果");
                return;
            }

            if (dbManager.SaveFortuneRecord(frmStart.currentUserId, result))
            {
                MessageBox.Show("占卜結果已保存");
                LoadFortuneRecords();
            }
        }
    }
}
