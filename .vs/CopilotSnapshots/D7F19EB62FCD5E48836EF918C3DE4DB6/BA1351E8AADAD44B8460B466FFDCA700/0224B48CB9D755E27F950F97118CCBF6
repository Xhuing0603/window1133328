    public partial class frmFortune : Form
    {
        private DatabaseManager dbManager;
        private YijingService yijingService;
        private List<YaoType> currentYaos;
        private GuaXiang primaryGua;
        private GuaXiang changedGua;

        public frmFortune()
        {
            InitializeComponent();
            dbManager = new DatabaseManager();
            yijingService = new YijingService();
            currentYaos = new List<YaoType>();
