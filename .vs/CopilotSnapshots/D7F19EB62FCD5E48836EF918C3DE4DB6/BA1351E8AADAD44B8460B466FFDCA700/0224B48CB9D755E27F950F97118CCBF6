            登入ToolStripMenuItem.Click += LogoutToolStripMenuItem_Click;
            本月飲食ToolStripMenuItem.Click += PastRecordsToolStripMenuItem_Click;
            聯絡我們ToolStripMenuItem.Click += ContactUsToolStripMenuItem_Click;
        }

