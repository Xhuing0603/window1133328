            frmStart.login = false;
            frmStart.currentUsername = "";
            frmStart.currentUserId = -1;

            MessageBox.Show("已登出");
            this.Close();
        }

        private void PastRecordsToolStripMenuItem_Click(object sender, EventArgs e)
        {
            // 顯示過去紀錄（目前已在此頁面）
            MessageBox.Show("這是過去紀錄頁面，您可以查看下方的占卜結果列表");
        }

